  "figure": {
    "id": "F20",
    "title": "从结肠组织到结直肠癌的跨层观察",
    "source_paragraphs": "P0560–P0567同人非肿瘤黏膜/癌组织配对；P0574–P0626生长控制、RNA程序、蛋白、资源分配与组织行为；P0629为学习简化；P0630–P0673不一致与反馈边界。",
    "cognitive_task": "配对样本中各层测量能检验同一疾病故事，任一层变化仍不保证下一层同向改变。",
    "layout_rationale": "左右两列对照同一个人的非肿瘤结肠黏膜与结直肠癌组织；五行分别显示DNA、RNA、蛋白质、代谢物和组织行为。取样关系用观察点线，不用演变箭头。",
    "essential_objects": "同一人两份组织、共同遗传背景、后来体细胞变化、RNA分裂/合成程序、蛋白执行状态、代谢资源、细胞增多/排列紊乱。",
    "relationships": "配对比较；各层分别观察；层间解释是待检验联系；组织混合细胞及非一致可能作为边界。",
    "misconceptions": "不把配对样本画成同一块组织的实测纵向演变；不捏造具体突变/数值/热图；不把所有癌症同化为唯一链；非肿瘤癌旁不称完美健康。",
    "components": "同人取样标题、两份样本节点、两条观察取样线、五个层级标签、十个并列观察卡、配对而非纵向及跨层解释待检验范围说明。",
